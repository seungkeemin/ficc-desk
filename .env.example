# 이 파일을 .env 로 복사하고 값을 채운다. .env 는 .gitignore 되어 커밋되지 않는다.
#
#   copy .env.example .env
#
# 키가 비어 있으면 해당 소스의 필드는 전부 skipped(키 없음)로 표시되고,
# 수집 스크립트는 죽지 않는다. 나머지 소스는 정상 수집된다.

# 한국은행 경제통계시스템 — https://ecos.bok.or.kr/api/  (오픈API > 인증키 신청)
# 기준금리·KOFR·CD·CP·통안, 국고채 1/3/5/10/20/30년, 회사채 AA-/BBB- 3년,
# USD/KRW·원/100엔·원/위안 — 16 필드
ECOS_API_KEY=

# 세인트루이스 연준 — https://fred.stlouisfed.org/docs/api/api_key.html
# UST 3M/2/5/10/30년, SOFR, FF 목표 상단, 10년 BEI, 미 IG/HY OAS,
# USD/JPY·EUR/USD, VIX — 13 필드
FRED_API_KEY=

# 한국거래소 Data Marketplace — https://openapi.krx.co.kr/
# 국채선물 3/10/30년 종가 + 3/10년 미결제약정 — 5 필드 (호출은 하루 1번, 응답 캐시).
# 인증키 발급과 별개로 해당 서비스 '활용신청' 승인이 필요하다. 채권(bon/*) 서비스는
# 승인 전이면 401 이다 — 승인되면 국채전문유통시장 체결수익률을 붙일 수 있다.
KRX_AUTH_KEY=

# DB 경로. 비우면 저장소 루트의 data/ficc.db 를 쓴다.
# 클라우드 동기화 폴더(OneDrive/Dropbox) 안에 두지 않는다 — WAL 파일이 깨진다.
FICC_DB_PATH=

# 옵시디언 볼트. Phase 6 에서만 쓴다. .obsidian/ 은 읽지도 쓰지도 않는다.
OBSIDIAN_VAULT_PATH=
